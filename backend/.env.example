# ==============================================================
# AgriSense AI Conversational Assistant - LLM Configuration
# ==============================================================
# Configure at least ONE of the following genuine LLM providers:

# 1. Google Gemini API (Recommended for Indian Languages & Multilingual Intelligence)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-1.5-flash):
# GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud API (High-Speed Llama 3.3 70B & Mixtral)
# Get your free key at: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI API (GPT-4o-mini / GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# Optional model override (default: gpt-4o-mini):
# OPENAI_MODEL=gpt-4o-mini
