# AgriSense Smart Agriculture Weather Monitoring
# Environment Configuration

# Optional: Default Location Override
# VITE_DEFAULT_LATITUDE=30.9010
# VITE_DEFAULT_LONGITUDE=75.8573
# VITE_DEFAULT_CITY=Ludhiana

# Open-Meteo operates without an API key for open research and agricultural use.
# If you have an Open-Meteo Commercial API key, specify it here:
# VITE_OPEN_METEO_API_KEY=your_commercial_key_here

# IoT ESP32 Telemetry Module Webhook (Module 2)
# VITE_ESP32_WEBHOOK_URL=http://localhost:5000/api/v1/telemetry/esp32

# ==============================================================
# AgriSense AI Assistant - Generative LLM Integration (Optional)
# Configure either Google Gemini or OpenAI. If unconfigured, the
# platform uses the built-in offline agronomic reasoning engine.
# ==============================================================
# Google Gemini API Key (Recommended for multilingual Indian languages)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias recognized by Google AI SDK:
# GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative provider for GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional Model Overrides:
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini

